# Producción (VPS), usado por docker-compose.prod.yml.
# Copiar como .env.production y rellenar. Nunca se commitea (ver .gitignore).

# La DB vive en el Postgres COMPARTIDO de shared-infra-MGVPS (contenedor "mgvps-postgres",
# mismo mgvps-network), no en un Postgres propio de este proyecto.
DB_HOST=mgvps-postgres
DB_PORT=5432
DB_USER=onoso4circus
DB_PASSWORD=usar-la-misma-que-ONOSO4CIRCUS_DB_PASSWORD-en-shared-infra-MGVPS/postgresql/.env
DB_NAME=onoso4circus

# Generar uno nuevo de producción: openssl rand -hex 48
JWT_SECRET=cambiar-esto
JWT_EXPIRES_IN=8h

FRONTEND_URL=https://onoso4circus.circusnova.es
